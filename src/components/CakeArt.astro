---
// Sofie's cake, drawn at build time. One <g> per layer (data-layer matches
// the receipt) so the script can land each one alone. Without JS the whole
// cake simply stands there, finished.
import { ink, arc, line, drum, rng, type Pt } from "../lib/hand";
interface Props { piped: string }
const { piped } = Astro.props;

const CX = 300;
const RY = 34;
const RX = 150;
const OFF: Pt = [2.5, 2]; // fills sit a little off the ink, like a print

const fillOf = (pts: Pt[], seed: number) =>
  ink(pts.map(([x, y]) => [x + OFF[0], y + OFF[1]] as Pt), seed, 2.2, true);

/** x-span of the front face of a drum at height y (front arc of top edge). */
const frontY = (cy: number, rx: number, x: number) => cy + RY * Math.sqrt(Math.max(0, 1 - ((x - CX) / rx) ** 2));

// ── layers, bottom up ──────────────────────────────────────────
const S1 = { top: 478, bot: 530 };
const JAM = { top: 467, bot: 478 };
const CREAM = { top: 443, bot: 467 };
const S2 = { top: 391, bot: 443 };
const MZ = { top: 383, bot: 534, rx: RX + 12 };

function spongeBits(top: number, bot: number, seed: number) {
  const r = rng(seed);
  const pores: string[] = [];
  for (let i = 0; i < 26; i++) {
    const x = CX - RX * 0.88 + r() * RX * 1.76;
    const y0 = frontY(top, RX, x) + 6;
    const y1 = frontY(bot, RX, x) - 5;
    if (y1 <= y0) continue;
    const y = y0 + r() * (y1 - y0);
    const w = 2 + r() * 2.6;
    pores.push(ink(arc(x, y, w, w * 0.6, Math.PI * 0.1, Math.PI * 1.2, 6), seed + i, 0.4));
  }
  const hatch: string[] = [];
  for (let i = 0; i < 5; i++) {
    const x = CX + RX * (0.62 + i * 0.07);
    const y = frontY(top, RX, x) + 10 + i * 2;
    hatch.push(ink(line([x, y], [x + 5, y + (bot - top) * 0.55], 3), seed + 50 + i, 0.6));
  }
  return { pores, hatch };
}

const layers = {
  sponge: {
    fill: fillOf(drum(CX, S1.top, S1.bot, RX, RY), 11),
    topFill: ink(arc(CX, S1.top, RX - 2, RY - 2, 0, Math.PI * 2, 40), 12, 1.2, true),
    ...spongeBits(S1.top, S1.bot, 13),
    outline: [ink(drum(CX, S1.top, S1.bot, RX, RY), 14, 1.4, true), ink(arc(CX, S1.top, RX, RY, 0, Math.PI, 28), 15)],
  },
  jam: {
    fill: fillOf(drum(CX, JAM.top, JAM.bot, RX + 1, RY), 21),
    drips: [-96, -40, 22, 70, 118].map((dx, i) => {
      const x = CX + dx;
      const y = frontY(JAM.bot, RX, x) - 2;
      const len = 9 + ((i * 7) % 12);
      const w = 3.2 + (i % 2);
      return ink([[x - w, y], [x - w * 0.8, y + len * 0.6], [x - w * 0.9, y + len], [x, y + len + w * 0.9], [x + w * 0.9, y + len], [x + w * 0.8, y + len * 0.6], [x + w, y]], 22 + i, 0.5, true);
    }),
    outline: [ink(drum(CX, JAM.top, JAM.bot, RX + 1, RY), 24, 1.2, true), ink(arc(CX, JAM.top, RX + 1, RY, 0, Math.PI, 28), 25)],
  },
  cream: {
    fill: fillOf(drum(CX, CREAM.top, CREAM.bot, RX + 4, RY), 31),
    topFill: ink(arc(CX, CREAM.top, RX + 2, RY - 1, 0, Math.PI * 2, 40), 32, 1.6, true),
    swirls: [-110, -62, -14, 34, 82, 122].map((dx, i) => {
      const x = CX + dx;
      const y = (frontY(CREAM.top, RX, x) + frontY(CREAM.bot, RX, x)) / 2;
      return ink(arc(x, y, 7, 4, Math.PI * 1.1, Math.PI * 2.6, 10), 33 + i, 0.5);
    }),
    outline: [ink(drum(CX, CREAM.top, CREAM.bot, RX + 4, RY), 39, 2.6, true), ink(arc(CX, CREAM.top, RX + 4, RY, 0, Math.PI, 28), 40, 2)],
  },
  sponge2: {
    fill: fillOf(drum(CX, S2.top, S2.bot, RX, RY), 41),
    topFill: ink(arc(CX, S2.top, RX - 2, RY - 2, 0, Math.PI * 2, 40), 42, 1.2, true),
    ...spongeBits(S2.top, S2.bot, 43),
    outline: [ink(drum(CX, S2.top, S2.bot, RX, RY), 44, 1.4, true), ink(arc(CX, S2.top, RX, RY, 0, Math.PI, 28), 45)],
  },
};

// marzipan: a lid with soft folds where it pools at the hem
const hem: Pt[] = arc(CX, MZ.bot, MZ.rx + 4, RY + 2, Math.PI, 0, 60).map(([x, y], i) => [x, y + 3.5 * Math.abs(Math.sin(i * 0.52))] as Pt);
const mzShape: Pt[] = [
  ...line([CX - MZ.rx, MZ.top + 4], [CX - MZ.rx - 4, MZ.bot], 6),
  ...hem.slice(1),
  ...line([CX + MZ.rx + 4, MZ.bot], [CX + MZ.rx, MZ.top + 4], 6).slice(1),
  ...arc(CX, MZ.top, MZ.rx, RY + 1, 0, -Math.PI, 30).slice(1, -1),
];
const marzipan = {
  fill: ink(mzShape, 51, 1.3, true), // no offset: nothing behind may show at the edge
  topFill: ink(arc(CX, MZ.top, MZ.rx - 3, RY - 1, 0, Math.PI * 2, 44), 52, 1, true),
  shoulder: ink(arc(CX, MZ.top + 3, MZ.rx - 1, RY + 3, Math.PI * 0.94, Math.PI * 0.06, 30), 53, 1.2),
  folds: [-118, -64, 58, 112].map((dx, i) => {
    const x = CX + dx;
    const y1 = frontY(MZ.bot, MZ.rx, x) + 2;
    return ink(line([x + (dx > 0 ? -3 : 3), y1 - 34 - (i % 2) * 12], [x, y1], 4), 54 + i, 0.8);
  }),
  outline: ink(mzShape, 60, 1.3, true),
};

// raspberries round the rim, back row first so the front ones overlap
const rb = rng(71);
const berries = Array.from({ length: 10 }, (_, i) => {
  const a = (i / 10) * Math.PI * 2 + 0.3;
  return { x: CX + Math.cos(a) * (MZ.rx - 26), y: MZ.top + Math.sin(a) * (RY - 8) - 8, r: 10 + rb() * 2, s: 72 + i * 7 };
})
  .sort((a, b) => a.y - b.y)
  .map(({ x, y, r, s }) => ({ x, y, k: r / 11, rot: ((s * 37) % 17) - 8 }));
// one raspberry, drawn once at r = 11 and placed ten times
const R = 11;
const berry = {
  // thimble: rounder at the base, narrower at the tip
  body: ink(arc(0, 0, R, R * 1.2, 0, Math.PI * 2, 16).map(([px, py]) => [px * (1 - 0.18 * Math.max(0, -py / (R * 1.2))), py] as Pt), 72, 0.5, true),
  seeds: ([[-0.5, 0.45], [0, 0.55], [0.5, 0.45], [-0.55, 0], [0, 0.05], [0.55, 0], [-0.4, -0.45], [0.05, -0.5], [0.45, -0.42]] as Pt[])
    .map(([u, v]) => [u * R, v * R * 1.1] as Pt),
  shine: ink(arc(-R * 0.3, -R * 0.5, R * 0.22, R * 0.16, Math.PI * 1.1, Math.PI * 1.7, 4), 81, 0.1),
};
const rc = rng(91);
const crumbs = Array.from({ length: 16 }, (_, i) => {
  const a = rc() * Math.PI * 2, d = Math.sqrt(rc()) * 0.55;
  const x = CX + Math.cos(a) * MZ.rx * d, y = MZ.top + Math.sin(a) * RY * d;
  const w = 2 + rc() * 1.6;
  return ink([[x - w, y - 0.4], [x - w * 0.3, y - w * 0.8], [x + w * 0.7, y - w * 0.5], [x + w, y + 0.4], [x + w * 0.2, y + w * 0.7], [x - w * 0.8, y + w * 0.5]], 92 + i, 0.3, true);
});

// Dannebrog on toothpicks: 28:37, cross 12-4-12 / 12-4-21, cross near the stick
function flag(stickX: number, side: 1 | -1, seed: number) {
  const top = 318, foot = MZ.top + 6;
  const k = 1.15;
  const X = (u: number) => stickX + side * u * k;
  const Y = (v: number) => top + v * k;
  const rect = (u1: number, v1: number, u2: number, v2: number): Pt[] => [
    ...line([X(u1), Y(v1)], [X(u2), Y(v1)], 5), ...line([X(u2), Y(v1)], [X(u2), Y(v2)], 3).slice(1),
    ...line([X(u2), Y(v2)], [X(u1), Y(v2)], 5).slice(1), ...line([X(u1), Y(v2)], [X(u1), Y(v1)], 3).slice(1, -1),
  ];
  return {
    stick: ink(line([stickX, top - 4], [stickX + side * 3, foot], 5), seed, 0.6),
    red: ink(rect(0, 0, 37, 28), seed + 1, 0.8, true),
    crossH: ink(rect(0.5, 12, 36.5, 16), seed + 2, 0.3, true),
    crossV: ink(rect(12, 0.5, 16, 27.5), seed + 3, 0.3, true),
    outline: ink(rect(0, 0, 37, 28), seed + 4, 0.8, true),
  };
}
const flags = [flag(222, -1, 101), flag(378, 1, 111)];

// the name follows the front of the cake
const namePath = ink(arc(CX, 446, MZ.rx - 10, RY + 4, Math.PI * 0.86, Math.PI * 0.14, 24), 131, 0.6);

// plate with a paper doily
const plate = {
  under: ink(arc(CX, S1.bot + 6, 232, RY + 22, 0, Math.PI * 2, 60), 121, 1.6, true),
  top: ink(arc(CX, S1.bot, 228, RY + 20, 0, Math.PI * 2, 60), 122, 1.6, true),
  doily: ink(arc(CX, S1.bot, 196, RY + 13, 0, Math.PI * 2, 96).map(([x, y], i) => {
    const k = 1 + 0.03 * Math.abs(Math.sin(i * Math.PI / 4 * 1.5));
    return [CX + (x - CX) * k, S1.bot + (y - S1.bot) * k] as Pt;
  }), 123, 0.6, true),
  holes: Array.from({ length: 36 }, (_, i) => {
    const a = (i / 36) * Math.PI * 2;
    return [CX + Math.cos(a) * 184, S1.bot + Math.sin(a) * (RY + 8)] as Pt;
  }).filter(([, y]) => y > S1.bot + 6),
  rim: ink(arc(CX, S1.bot + 2, 210, RY + 15, Math.PI * 0.05, Math.PI * 0.95, 30), 124, 0.8),
};
---

<svg class="cake-art" viewBox="40 284 520 314" role="img" aria-labelledby="cake-art-title">
  <title id="cake-art-title">Drawing of a birthday cake: two vanilla sponges with raspberry jam and vanilla cream, under a marzipan lid with raspberries, pistachio, two Danish paper flags and “{piped}” piped on the front.</title>
  <defs>
    <clipPath id="mz-clip"><rect class="mz-curtain" x="0" y="300" width="600" height="300" /></clipPath>
    <clipPath id="name-clip"><rect class="name-curtain" x="140" y="420" width="320" height="90" /></clipPath>
    <path id="name-path" d={namePath} />
    <g id="berry">
      <!-- colours as attributes: a <use> copy does not see page CSS through .cake-art -->
      <path d={berry.body} fill="#c42a52" stroke="#3b2316" stroke-width="2.4" stroke-linejoin="round" />
      <g fill="none" stroke="#3b2316" stroke-width="1.1" opacity=".5">
        {berry.seeds.map(([x, y]) => <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="2.6" />)}
      </g>
      <path d={berry.shine} fill="none" stroke="#ffd6df" stroke-width="1.8" stroke-linecap="round" />
    </g>
  </defs>

  <g class="plate">
    <path class="f-shadow" d={plate.under} />
    <path class="f-plate ink" d={plate.top} />
    <path class="ink thin" d={plate.rim} />
    <path class="f-doily ink thin" d={plate.doily} />
    {plate.holes.map(([x, y]) => <circle class="hole" cx={x.toFixed(1)} cy={y.toFixed(1)} r="2.2" />)}
  </g>

  <g class="layer" data-layer="sponge">
    <path class="f-sponge" d={layers.sponge.fill} />
    <path class="f-sponge-top" d={layers.sponge.topFill} />
    {layers.sponge.pores.map(d => <path class="ink thin" d={d} />)}
    {layers.sponge.hatch.map(d => <path class="ink hair" d={d} />)}
    {layers.sponge.outline.map(d => <path class="ink" d={d} />)}
  </g>

  <g class="layer" data-layer="jam">
    <path class="f-jam" d={layers.jam.fill} />
    {layers.jam.drips.map(d => <path class="f-jam ink thin" d={d} />)}
    {layers.jam.outline.map(d => <path class="ink" d={d} />)}
  </g>

  <g class="layer" data-layer="cream">
    <path class="f-cream" d={layers.cream.fill} />
    <path class="f-cream-top" d={layers.cream.topFill} />
    {layers.cream.swirls.map(d => <path class="ink hair" d={d} />)}
    {layers.cream.outline.map(d => <path class="ink" d={d} />)}
  </g>

  <g class="layer" data-layer="sponge2">
    <path class="f-sponge" d={layers.sponge2.fill} />
    <path class="f-sponge-top" d={layers.sponge2.topFill} />
    {layers.sponge2.pores.map(d => <path class="ink thin" d={d} />)}
    {layers.sponge2.hatch.map(d => <path class="ink hair" d={d} />)}
    {layers.sponge2.outline.map(d => <path class="ink" d={d} />)}
  </g>

  <g class="layer" data-layer="marzipan" clip-path="url(#mz-clip)">
    <path class="f-marzipan" d={marzipan.fill} />
    <path class="f-marzipan-top" d={marzipan.topFill} />
    <path class="ink thin" d={marzipan.shoulder} />
    {marzipan.folds.map(d => <path class="ink hair" d={d} />)}
    <path class="ink" d={marzipan.outline} />
  </g>

  <g class="layer" data-layer="berries">
    {crumbs.map(d => <path class="f-pistachio" d={d} />)}
    {/* the script animates the outer <g>; GSAP rewriting the <use>'s own transform loses its placement */}
    {berries.map(b => <g class="berry"><use href="#berry" transform={`translate(${b.x.toFixed(1)} ${b.y.toFixed(1)}) rotate(${b.rot}) scale(${b.k.toFixed(2)})`} /></g>)}
  </g>

  <g class="layer" data-layer="name">
    {flags.map(f => (
      <g class="flag">
        <path class="ink" d={f.stick} />
        <path class="f-flag" d={f.red} />
        <path class="f-cross" d={f.crossH} />
        <path class="f-cross" d={f.crossV} />
        <path class="ink thin" d={f.outline} />
      </g>
    ))}
    <g clip-path="url(#name-clip)">
      <text class="piped" text-anchor="middle"><textPath href="#name-path" startOffset="50%">{piped}</textPath></text>
    </g>
  </g>
</svg>

<style is:global>
  .cake-art { display: block; width: 100%; height: auto; overflow: visible; }
  .cake-art .ink { fill: none; stroke: var(--ink); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .cake-art .thin { stroke-width: 1.6; }
  .cake-art .hair { stroke-width: 1.2; opacity: .7; }
  .cake-art .f-shadow { fill: var(--ink); opacity: .12; }
  .cake-art .f-plate { fill: #fffaf0; }
  .cake-art .f-doily { fill: #fffdf8; }
  .cake-art .hole { fill: var(--paper); stroke: var(--ink); stroke-width: .8; opacity: .8; }
  .cake-art .f-sponge { fill: #e8bd6a; }
  .cake-art .f-sponge-top { fill: #f0cf8a; }
  .cake-art .f-jam { fill: var(--raspberry-deep); }
  .cake-art .f-cream { fill: #fbf3dc; }
  .cake-art .f-cream-top { fill: #fffaea; }
  .cake-art .f-marzipan { fill: #f1e2c2; }
  .cake-art .f-marzipan-top { fill: #f8ecd2; }
  .cake-art .f-pistachio { fill: var(--pistachio); stroke: #5c7330; stroke-width: .6; }
  .cake-art .f-flag { fill: #c8102e; }
  .cake-art .f-cross { fill: #fff; }
  .cake-art .piped {
    font-family: var(--display); font-size: 31px; letter-spacing: .5px;
    fill: var(--raspberry); stroke: #fffaf0; stroke-width: 5px; stroke-linejoin: round; paint-order: stroke;
  }
</style>
