---
import { ink, type Pt } from "../lib/hand";
import CakeBox from "./CakeBox.astro";
// a line of piping under "before": loose loops, the way a nozzle tests itself
const loops: Pt[] = Array.from({ length: 60 }, (_, i) => {
  const t = i / 59;
  return [6 + t * 300 + Math.cos(t * Math.PI * 11) * -6, 17 + Math.sin(t * Math.PI * 11) * 6 * (0.55 + 0.45 * Math.sin(t * Math.PI))] as Pt;
});
const piping = ink(loops, 7, 0.8);
---

<header class="top">
  <a class="mark" href="/">Lag på Lag</a>
  <nav aria-label="Main">
    <a href="#byg">Build a cake</a>
    <a href="#order">Order</a>
  </nav>
</header>

<section class="hero" aria-labelledby="hero-title">
  <p class="eyebrow">Konditori · Amagerbrogade, Copenhagen</p>
  <h1 id="hero-title">
    <span class="w">See</span> <span class="w">the</span> <span class="w">cake</span>
    <span class="w u">before<svg class="pipe" viewBox="0 0 312 34" aria-hidden="true"><path d={piping} pathLength="1" /></svg></span>{" "}
    <span class="w">you</span> <span class="w">order</span> <span class="w">it.</span>
  </h1>
  <p class="lede">
    We only bake celebration cakes. Birthdays, christenings, the “we got the flat” cake.
    Scroll down and watch one get built, layer by layer, with the price adding up as it goes.
  </p>
  <div class="art-box"><CakeBox /></div>
  <div class="ctas">
    <a class="btn" href="#byg">Build Sofie’s cake <span aria-hidden="true">↓</span></a>
    <a class="btn quiet" href="#order">Order a cake</a>
  </div>
</section>

<style>
  .top {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1.1rem var(--gutter); background: var(--kraft);
  }
  .mark { font: 1.5rem/1 var(--display); text-decoration: none; }
  nav { display: flex; gap: clamp(.9rem, 3vw, 2rem); font-weight: 600; }
  nav a { text-decoration: none; padding: .3rem 0; border-bottom: 2px solid transparent; }
  nav a:hover { border-color: currentColor; }

  .hero {
    position: relative; overflow: hidden;
    background: var(--kraft);
    padding: clamp(1.5rem, 5vw, 3.5rem) var(--gutter) clamp(3rem, 7vw, 5.5rem);
    border-bottom: 2.5px solid var(--ink);
  }
  .eyebrow { font-weight: 600; letter-spacing: .02em; margin-bottom: .9rem; }
  h1 {
    font-size: clamp(3.1rem, 10.5vw, 9.5rem); line-height: 1.04; letter-spacing: -.01em;
    max-width: 11ch;
  }
  .w { display: inline-block; }
  .u { position: relative; color: var(--raspberry-deep); }
  .pipe { position: absolute; left: 0; bottom: -.1em; width: 100%; height: .2em; overflow: visible; }
  .pipe path { fill: none; stroke: var(--raspberry-deep); stroke-width: 4.5; stroke-linecap: round; stroke-linejoin: round; }
  .lede { max-width: 34rem; font-size: clamp(1.08rem, 1.6vw, 1.25rem); margin-top: clamp(1.6rem, 3vw, 2.4rem); }
  .ctas { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .art-box { display: none; }
  @media (min-width: 1000px) {
    .art-box {
      display: block; position: absolute; right: clamp(1rem, 5vw, 6rem); bottom: clamp(2rem, 6vw, 5rem);
      width: min(34vw, 30rem); transform: rotate(-4deg);
    }
  }

  /* the entrance is CSS only: words rise, then the piping draws itself */
  @media (prefers-reduced-motion: no-preference) {
    .w { animation: rise .7s cubic-bezier(.2, .8, .2, 1) both; }
    .w:nth-child(2) { animation-delay: .06s } .w:nth-child(3) { animation-delay: .12s }
    .w:nth-child(4) { animation-delay: .18s } .w:nth-child(5) { animation-delay: .24s }
    .w:nth-child(6) { animation-delay: .30s } .w:nth-child(7) { animation-delay: .36s }
    .pipe path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: pipe 1.1s .75s ease-out forwards; }
    .art-box { animation: drop .8s .35s cubic-bezier(.3, 1.4, .5, 1) both; }
    .lede, .ctas { animation: rise .7s .5s cubic-bezier(.2, .8, .2, 1) both; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(.35em); } }
  @keyframes drop { from { opacity: 0; translate: 0 -2.5rem; } }
  @keyframes pipe { to { stroke-dashoffset: 0; } }
</style>
