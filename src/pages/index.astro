---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import BuildCake from "../components/BuildCake.astro";
import Cakes from "../components/Cakes.astro";
import Order from "../components/Order.astro";
import Visit from "../components/Visit.astro";
import { getSettings, getBuildCake, getCakes } from "../lib/sanity";

const [settings, cake, cakes] = await Promise.all([getSettings(), getBuildCake(), getCakes()]);
---

<Base
  title="Lag på Lag · Celebration cakes on Amagerbrogade"
  description="An invented Copenhagen konditori that only bakes celebration cakes. Watch your cake get built, layer by layer, before you order."
>
  <a class="skip" href="#main">Skip to content</a>
  <Hero settings={settings} />
  <main id="main">
    <BuildCake cake={cake} />
    <Cakes cakes={cakes} />
    <Order cakes={cakes} build={cake} />
    <Visit hours={settings.hours} />
  </main>
  <footer class="foot">
    <p><strong>Lag på Lag is invented.</strong> Ice’s Stack made it as a design sample. Nobody sells cakes here, and Sofie is made up too.</p>
  </footer>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
</Base>

<style>
  .foot { padding: 2rem var(--gutter); background: var(--ink); color: var(--paper); font-size: .95rem; }
</style>
